# Copy this file to server/.env and fill in the real values there. NEVER put real keys in THIS file:
# .env.example is committed to GitHub, .env is not.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173          # production: https://leensummaqa.com (the only website allowed to call the API)
SITE_URL=https://leensummaqa.com          # the public address, used in sitemap.xml

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
# SECRET: bypasses all database security. Server only. Never in the React app, never in Git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ---- Payments ----
# mock = fake bank page for development. hyperpay = the real gateway. The server refuses to start in production with mock.
PAYMENT_PROVIDER=mock
HYPERPAY_BASE_URL=                        # test: https://eu-test.oppwa.com   live: the address HyperPay gives you
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_WEBHOOK_KEY=                     # not used yet (the webhook is not implemented)
HYPERPAY_TEST_MODE=true                   # true ONLY with the test server (eu-test.oppwa.com). Set false for the live server.
# HYPERPAY_AMOUNT_DECIMALS=3              # decimals sent to the live server for JOD (confirm with HyperPay)

# ---- Email (Brevo SMTP). Leave SMTP_HOST empty in development: emails are then printed in the server console. ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Leen Summaqa <orders@leensummaqa.com>
ADMIN_NOTIFY_EMAIL=                       # who is told about new orders and contact messages (Leen's email)

# ---- Optional tuning ----
UNPAID_ORDER_TTL_MINUTES=30               # unpaid orders are cancelled after this and their stock goes back on sale
# RATE_LIMIT_PER_MINUTE=120               # requests per visitor per minute (raise only for automated tests)
# AUTH_RATE_LIMIT_PER_15_MIN=20           # sign-in / sign-up attempts per visitor per 15 minutes
